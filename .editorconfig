root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Unciv's own rulesets use tabs
[*.json]
indent_style = tab
indent_size = 4

# Translations: UTF-8 without BOM, "English text = Перевод"
[*.properties]
charset = utf-8

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
